# Discord bot token
TOKEN=

# What language model to use, orca is one of the lower-end models that doesn't require as much computer power as llama2
MODEL=orca

# Ollama server URL(s), comma-separated. Servers are tried in order (first = highest priority).
OLLAMA=http://localhost:11434

# Stable Diffusion server URL(s), comma-separated. Servers are tried in order (first = highest priority).
STABLE_DIFFUSION=http://localhost:7860

# What Discord channels to enable it in (by ID), comma-separated. Leave empty to allow all channels.
# Threads inside a listed channel are allowed too, and DMs are always allowed.
CHANNELS=123456789,987654321

# System message that the language model can understand
# Feel free to change this
SYSTEM="The current date and time is <date>.

Basic markdown is supported.
Bold: **bold text here**
Italics: _italic text here_
Underlined: __underlined text here__
Strikethrough: ~~strikethrough text here~~
Spoiler: ||spoiler text here||
Block quotes: Start the line with a > followed by a space, e.g
> Hello there

Inline code blocks are supported by surrounding text in backticks, e.g `print('Hello');`, block code is supported by surrounding text in three backticks, e.g ```print('Hello');```.
Surround code that is produced in code blocks. Use a code block with three backticks if the code has multiple lines, otherwise use an inline code block with one backtick.

Links are supported by wrapping the text in square brackets and the link in parenthesis, e.g [Example](https://example.com)

Lists are supported by starting the line with a dash followed by a space, e.g - List
Numbered lists are supported by starting the line with a number followed by a dot and a space, e.g 1. List.
Images, links, tables, LaTeX, and anything else is not supported.

If you need to use the symbols >, |, _, *, ~, @, #, :, `, put a backslash before them to escape them.

If the user is chatting casually, your responses should be only a few sentences, unless they are asking for help or a question.
Don't use unicode emoji unless needed."

# Use the system message above? (true/false)
USE_SYSTEM=true

# Use the model's system message? (true/false) If both are specified, model system message will be first
USE_MODEL_SYSTEM=true

# Tell the model who it is and where it is talking (true/false). Adds the bot's
# name, @username, application description, avatar and banner links, the server,
# channel and channel topic, the name of the person asking, and the current date
# and time to the system prompt of /chat and /generate. It goes after the model's
# system message and before SYSTEM. On unless set to false, so the server and
# channel names are shared with your Ollama servers by default.
USE_BOT_CONTEXT=true



# Per-request timeout for Ollama / Stable Diffusion calls, in milliseconds.
# Set to 0 (the default) to disable the timeout, which is recommended for slow
# LLM generations that may otherwise be cut off prematurely.
REQUEST_TIMEOUT=0

# How long a request waits for a free Ollama / Stable Diffusion server when all
# of them are busy, in milliseconds, before failing with "All servers busy".
# Defaults to 60000. Set to 0 to wait indefinitely, but note that Discord
# interactions expire after 15 minutes, so replies to longer waits are lost.
SERVER_WAIT_TIMEOUT=60000

# How long a streamed Ollama response may go without sending data, in
# milliseconds, before it is aborted and its server freed for other requests.
# Defaults to 60000. Set to 0 to disable.
STREAM_IDLE_TIMEOUT=60000

# Maximum length for attachment text
MAX_ATTACHMENT_TEXT_LENGTH=8000

# SQLite database file that stores /chat history, so conversations survive
# restarts. Relative paths start from the folder the bot is started in, and
# missing folders are created. Defaults to ./data/chat-history.db. With Docker
# Compose, keep it inside ./data so it is stored in the chat-history volume.
CHAT_HISTORY_DB=./data/chat-history.db

# Show buttons with Ollama's stats under each /chat and /generate answer: the
# model, response tokens, generation speed, prompt tokens, model load time and
# total time. Clicking one shows a breakdown only the person who clicked can
# see. On unless set to false.
SHOW_STATS=true
